// This file contains the Waybar layout and module settings for the Shrine bar
{
    // Section: Bar placement
    // Bottom layer keeps the dynamic island above the bar, even after a Waybar reload
    "layer": "bottom",
    "position": "top",
    "height": 34,
    "margin-top": 5,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 4,

    // Section: Module order
    "modules-left": ["custom/launcher", "custom/dolphin", "custom/torii", "custom/brave", "tray"],
    // The centre is the Quickshell dynamic island (config/quickshell)
    "modules-center": [],
    // CPU, RAM, temperature and volume live in the island
    "modules-right": ["custom/tasks", "custom/ytmusic", "custom/nightlight", "idle_inhibitor", "custom/power"],

    // Section: App shortcuts
    "custom/launcher": { 
        "format": "󰀻", 
        "on-click": "setsid -f bash ~/.config/rofi/launcher.sh", 
        "tooltip": false 
    },

    "custom/dolphin": { 
        "format": "", 
        "on-click": "setsid -f dolphin", 
        "tooltip": false 
    },

    "custom/torii": { 
        "format": "⛩\ufe0e", 
        "on-click": "setsid -f gtk-launch io.github.kolunmi.Bazaar", 
        "tooltip": false 
    },

    "custom/brave": { 
        "format": "󰖟", 
        "on-click": "setsid -f flatpak run com.brave.Browser", 
        "tooltip": false 
    },

    "tray": { 
        "icon-size": 18, 
        "spacing": 10 
    },

    // Section: Media and visualiser
    "custom/media": {
        "format": "{icon} {text}",
        "return-type": "json",
        "format-icons": {
            "playing": "󰝚",
            "paused": "",
            "none": ""
        },
        "max-length": 40,
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "exec": "python3 ~/.config/waybar/mediaplayer.py 2> /dev/null",
        "interval": 1
    },

    "custom/cava": {
        "exec": "bash ~/.config/waybar/cava.sh",
        "format": "{}",
        "tooltip": false
    },

    // Section: Clock and calendar
    "clock": {
        "format": "  {:%H:%M}",
        "on-click": "flatpak run org.gnome.Evolution --component=calendar",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode"          : "year",
            "mode-mon-col"  : 4,
            "on-scroll"     : 1,
            "on-click-right": "mode",
            "format": {
                "months":     "<span color='#CB3F27'><b>{}</b></span>",
                "days":       "<span color='#E5D3B3'><b>{}</b></span>",
                "weekdays":   "<span color='#FF8C00'><b>{}</b></span>",
                "today":      "<span color='#CB3F27'><b><u>{}</u></b></span>"
            }
        },
        "actions":  {
            "on-click-left": "mode",
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    // Section: Keep awake
    // Click to stop the screen sleeping or locking; turns maple red while on
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "\uf0f4 ",
            "deactivated": "\uf0f4 "
        },
        "tooltip-format-activated": "Keeping awake",
        "tooltip-format-deactivated": "Sleep allowed"
    },

    // Section: YouTube Music
    "custom/ytmusic": {
        "format": "\uf16a ",
        "tooltip-format": "YouTube Music",
        "on-click": "setsid -f flatpak run app.ytmdesktop.ytmdesktop"
    },

    // Section: Today's task
    // Unfinished tasks from ~/Nextcloud/Tasks.txt, so they sync with your phone
    // Scroll to pick a task, click to mark it done, right-click to open the list
    "custom/tasks": {
        "exec": "python3 ~/.config/waybar/tasks.py",
        "return-type": "json",
        "interval": 5,
        "on-scroll-down": "python3 ~/.config/waybar/tasks.py --next",
        "on-scroll-up": "python3 ~/.config/waybar/tasks.py --previous",
        "on-click": "python3 ~/.config/waybar/tasks.py --done",
        "on-click-right": "python3 ~/.config/waybar/tasks.py --edit"
    },

    // Section: Night light
    // Glows amber whenever KDE's night light is warming the screen
    "custom/nightlight": {
        "exec": "bash ~/.config/waybar/night-light.sh",
        "return-type": "json",
        "interval": 3,
        "on-click": "bash ~/.config/waybar/night-light.sh --toggle"
    },

    // Section: Power
    "custom/power": { 
        "format": "⏻", 
        "on-click": "setsid -f bash ~/.config/rofi/power-menu.sh", 
        "tooltip": false 
    }
}
