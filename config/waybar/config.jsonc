// This file contains the Waybar layout and module settings for the Shrine bar
{
    // Section: Bar placement
    // Bottom layer keeps the dynamic island above the bar, even after a Waybar reload
    "layer": "bottom",
    "position": "top",
    "height": 34,
    "margin-top": 5,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 4,

    // Section: Module order
    "modules-left": ["custom/launcher", "custom/dolphin", "custom/torii", "custom/browser", "tray"],
    // The centre is the Quickshell dynamic island (config/quickshell)
    "modules-center": [],
    // CPU, RAM, temperature and volume live in the island
    "modules-right": ["custom/tasks", "custom/music", "custom/nightlight", "custom/keepawake", "custom/power"],

    // Section: App shortcuts
    // The launcher and power pills open the Quickshell menus, falling back to the rofi ones if the island isn't running
    "custom/launcher": { 
        "format": "󰀻", 
        "on-click": "qs ipc call menus toggle launcher || setsid -f bash ~/.config/rofi/launcher.sh", 
        "tooltip": false 
    },

    "custom/dolphin": { 
        "format": "", 
        "on-click": "setsid -f dolphin", 
        "tooltip": false 
    },

    "custom/torii": { 
        "format": "⛩\ufe0e", 
        // Your app store (SHRINE_STORE_APP in shrine.conf: Bazaar, Discover, …)
        "on-click": "bash ~/.config/shrine-waybar/run.sh store", 
        "tooltip": false 
    },

    "custom/browser": { 
        "format": "󰖟", 
        // Your browser (SHRINE_BROWSER_APP in shrine.conf)
        "on-click": "bash ~/.config/shrine-waybar/run.sh browser", 
        "tooltip": false 
    },

    "tray": { 
        "icon-size": 18, 
        "spacing": 10 
    },

    // Section: Media and visualiser
    "custom/media": {
        "format": "{icon} {text}",
        "return-type": "json",
        "format-icons": {
            "playing": "󰝚",
            "paused": "",
            "none": ""
        },
        "max-length": 40,
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "exec": "python3 ~/.config/waybar/mediaplayer.py 2> /dev/null",
        "interval": 1
    },

    "custom/cava": {
        "exec": "bash ~/.config/waybar/cava.sh",
        "format": "{}",
        "tooltip": false
    },

    // Section: Clock and calendar
    "clock": {
        "format": "  {:%H:%M}",
        "on-click": "flatpak run org.gnome.Evolution --component=calendar",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode"          : "year",
            "mode-mon-col"  : 4,
            "on-scroll"     : 1,
            "on-click-right": "mode",
            "format": {
                "months":     "<span color='#CB3F27'><b>{}</b></span>",
                "days":       "<span color='#E5D3B3'><b>{}</b></span>",
                "weekdays":   "<span color='#FF8C00'><b>{}</b></span>",
                "today":      "<span color='#CB3F27'><b><u>{}</u></b></span>"
            }
        },
        "actions":  {
            "on-click-left": "mode",
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    // Section: Keep awake
    // Quickshell holds the screen awake; this pill shows it and toggles it (the control centre does too)
    "custom/keepawake": {
        "exec": "bash ~/.config/shrine-waybar/run.sh keepawake-pill",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "qs ipc call controls toggleKeepAwake"
    },

    // Section: Music
    // Your music app (SHRINE_MUSIC_APP in shrine.conf); the icon and tooltip match the app
    "custom/music": {
        "exec": "bash ~/.config/shrine-waybar/run.sh music-pill",
        "return-type": "json",
        "interval": "once",
        "on-click": "bash ~/.config/shrine-waybar/run.sh music"
    },

    // Section: Today's task
    // Unfinished tasks from SHRINE_TASKS_FILE in shrine.conf (Nextcloud/Tasks.txt if you have Nextcloud)
    // Scroll to pick a task, click to mark it done, right-click to open the list
    "custom/tasks": {
        "exec": "python3 ~/.config/waybar/tasks.py",
        "return-type": "json",
        "interval": 5,
        "on-scroll-down": "python3 ~/.config/waybar/tasks.py --next",
        "on-scroll-up": "python3 ~/.config/waybar/tasks.py --previous",
        "on-click": "python3 ~/.config/waybar/tasks.py --done",
        "on-click-right": "python3 ~/.config/waybar/tasks.py --edit"
    },

    // Section: Night light
    // Glows amber whenever KDE's night light is warming the screen
    "custom/nightlight": {
        "exec": "bash ~/.config/waybar/night-light.sh",
        "return-type": "json",
        "interval": 3,
        "signal": 9,
        "on-click": "bash ~/.config/waybar/night-light.sh --toggle"
    },

    // Section: Power
    "custom/power": { 
        "format": "⏻", 
        "on-click": "qs ipc call menus toggle power || setsid -f bash ~/.config/rofi/power-menu.sh", 
        "tooltip": false 
    }
}
